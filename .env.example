# 環境変数の雛形。このファイルを `.env.local` にコピーして値を入れる。
# `.env.local` は .gitignore 対象（Git には入らない）。
# 保存は BOM なし UTF-8 で行うこと（BOM 付きだと変数名が変わり認識されない）。

# DMDATA.JP（Project DM-D.S.S）の API キー。キー発行は https://dmdata.jp/
# `npm run capture-scenario` が読む。加えて DMDSS 版の dev サーバーでは、アプリの設定タブの
# APIキー欄にこの値が初期値として入る（本番ビルド・standard 版・--host 付きでは入らない）。
# 詳細は docs/spec/settings-pwa-spec.md §6
DMDATA_API_KEY=

# NIED（防災科学技術研究所）K-NET/KiK-netのユーザー名・パスワード。登録は
# https://hinetwww11.bosai.go.jp/nied/registration/ から。
# `npm run capture-kyoshin-waveform` が読む。出力はNIEDの再配布禁止規約のためリポジトリに
# 含めない（.gitignore対象、生成した本人のローカル環境でのみ再生できる）。
# 詳細は docs/spec/settings-pwa-spec.md §6「NIED K-NET/KiK-netの実波形由来のデータ（ローカル限定・リアルタイム震度）」
NIED_KNET_USER=
NIED_KNET_PASSWORD=
