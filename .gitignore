# Dependencies
node_modules

# Build output
dist
dist-dmdss
dist-ssr

# Environment variables
.env
.env.*
!.env.example

# Local config
*.local

# TypeScript build cache
*.tsbuildinfo

# OS generated files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
logs/

# Test / verification artifacts
.playwright-mcp/
coverage/
# 強震モニタ実データ回帰ベンチ（npm run bench-kyoshin）が取得した Yahoo の過去フレーム。
# 全 793 窓で 500MB を超えるうえ、窓カタログから何度でも取り直せるためコミットしない
.probe-cache/
verify-*.png
verify-*.jpg
# dev サーバーの起動記録（scripts/dev-server-lock.ts が書き、npm run dev:list が読む）。
# 走っているプロセスの PID とポートなので、その端末のその瞬間にしか意味を持たない。
# **末尾の * を外さないこと** —— 書き込みは一時ファイル（`.dev-server.json.<PID>.tmp`）を
# 経由するので、置き換えに失敗した回はそれが残る。完全一致だと拾えず、git status に現れる。
.dev-server.json*

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea/

# Claude directories
.claude/*
# どの checkout でも揃えたい Claude Code の設定（いまは共有のタスクリストを選ぶ指定だけ。
# → CLAUDE.md「進める作業はタスク機能で管理する」）。コミットしておかないとワークツリーへ出ず、
# そこで始めたセッションが別のリストを見る。
# 端末ごとの設定（許可リスト等）は settings.local.json に置き、こちらは追跡しない。
!.claude/settings.json
# .claude/agents/ 配下はホワイトリスト方式:
# ディレクトリ自体は再包含して走査可能にし、中身は原則無視、
# 本プロジェクトで共通利用する定義だけを明示的に許可する。
# 新しい共通エージェントを追加するときは、本ファイルにも許可行を足すこと
# （足さないと git status にも git add -A にも現れず、サイレントに未追跡化される）。
# サブディレクトリを増やす場合は !.claude/agents/<dir>/ の再包含が別途必要。
!.claude/agents/
.claude/agents/*
!.claude/agents/adversarial-reviewer.md
!.claude/agents/doc-objectivity-reviewer.md
!.claude/agents/meta-reviewer.md
# .claude/skills/ も同じホワイトリスト方式。スキルは 1 つがディレクトリ単位のため、
# ディレクトリを再包含する行（!.claude/skills/<name>/）が要る。
# ただし ! でディレクトリを再包含すると配下が既定で追跡側に回るので、
# その直後に <name>/* で再度 ignore してから目的のファイルを ! で拾う。
# この 1 行を省くと、そのスキルのディレクトリに置いたメモが黙って追跡される。
!.claude/skills/
.claude/skills/*
!.claude/skills/release/
.claude/skills/release/*
!.claude/skills/release/SKILL.md
!.claude/skills/tts-reading-audit/
.claude/skills/tts-reading-audit/*
!.claude/skills/tts-reading-audit/SKILL.md
!.claude/skills/scratch-project-blocks/
.claude/skills/scratch-project-blocks/*
!.claude/skills/scratch-project-blocks/SKILL.md
!.claude/skills/scratch-project-blocks/scratch-blocks.mjs

# 実地震テストのシナリオ本体（DMDATA.JP利用規約第15条によりEEWの二次配信は
# 個人契約では制限されるため、各自の契約でキャプチャしたものはコミットしない。
# index.json は空配列のテンプレートとしてのみ管理する。
public/data/test-scenarios/*.json
!public/data/test-scenarios/index.json

# NIED K-NET/KiK-net由来のローカル限定強震モニタ風リプレイデータ（scripts/capture-kyoshin-waveform.ts
# の出力）。再配布禁止のためコミットしない。実行者本人のNIED登録でのみ生成・再生できる。
public/data/historical-archives-kyoshin/

# 検知アルゴリズムの試作・計測に使う使い捨てのスクリプトと、その出力。
# 手元で捨てられる前提のものなのでコミットしない。
# probe-*.ts はすべて使い捨て（正規の計測は scripts/bench-kyoshin.ts）。
# 出力側は先頭 / でリポジトリ直下に限定する。スラッシュを含まないパターンは
# 任意の階層のベース名に効くため、src/ や docs/ 配下の同名接頭辞まで
# 巻き込んで静かに追跡から漏らす。
/.probe-*
# o3.txt: 何かのコマンドの --version 出力を取り違えて書き出した残骸（1 行だけ）。
/o3.txt
scripts/probe-*.ts
scripts/_*.ts
scripts/_*.cjs
# dotagents: Codex temporary output
.codex/worktrees/
.codex/logs/
.codex/screenshots/
.codex/release.lock
.codex/import-backup/

# 自作地震計のセンサーノード: 接続先と資格情報は端末ごとに置く。
# 雛形（wifi_config.example.h）だけをコミットし、書き込んだ実物は入れない。
firmware/**/wifi_config.h

# 自作センサーの生データ（受け手が書き出す）
# **このリポジトリは公開されている**うえ、3 台 1 日で 350 MB 前後増える。
seismo-host/data/

# 観測点の設定（基板がどこに置かれているか。StationXML の stations.xml とその書きかけ）。
# 設置場所（＝自宅の間取り）を書くので、生データと同じ理由でコミットしない。
# 雛形（stations.example.xml）だけをコミットする。
seismo-host/config/*
!seismo-host/config/stations.example.xml
