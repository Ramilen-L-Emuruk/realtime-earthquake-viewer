{
  "name": "realtime-earthquake-viewer",
  "private": true,
  "version": "4.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:dmdss": "cross-env VITE_VARIANT=dmdss vite",
    "build": "tsc -b && vite build",
    "build:dmdss": "tsc -b && cross-env VITE_VARIANT=dmdss vite build",
    "preview": "vite preview",
    "preview:dmdss": "cross-env VITE_VARIANT=dmdss vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "maplibre-gl": "^6.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@mapbox/tiny-sdf": "^2.2.0",
    "@napi-rs/canvas": "^1.0.2",
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "mapshaper": "^0.7.49",
    "pbf": "^5.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.10"
  }
