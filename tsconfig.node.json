{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "scripts/capture-test-scenario.ts",
    "scripts/dev-api-key-gate.ts",
    "scripts/dev-api-key-gate.test.ts",
    "scripts/hypocenterRecord.ts",
    "scripts/hypocenterRecord.test.ts",
    "scripts/build-hypocenter-catalog.ts",
    "scripts/build-historical-archive-2011-tohoku.ts",
    "scripts/build-historical-archive-2016-kumamoto.ts",
    "scripts/build-historical-archive-2018-osaka.ts",
    "scripts/build-historical-archive-2016-tottori.ts",
    "scripts/build-historical-archive-2018-iburi.ts",
    "scripts/localEarthquakeArchiveBuilder.test.ts",
    "scripts/niiJmaXmlArchive.test.ts",
    "scripts/historicalEewParser.test.ts",
    "scripts/historicalEewArchiveBuilder.test.ts",
    "scripts/historicalTsunamiArchiveBuilder.test.ts",
    "scripts/capture-kyoshin-waveform.ts",
    "scripts/stationReading.ts",
    "scripts/stationReading.test.ts",
    "scripts/tsunamiStationReading.ts",
    "scripts/tsunamiStationReading.test.ts",
    "scripts/build-station-readings.ts",
    "scripts/stationReadings.test.ts",
    "scripts/telegram-audit/archiveCache.test.ts",
    "scripts/lib/xlsx.d.mts",
    "scripts/epicenterAccent.ts",
    "scripts/epicenterAccent.test.ts",
    "scripts/build-epicenter-accents.ts",
    "scripts/epicenterAccents.test.ts",
    "scripts/verify-particle-phrases.ts",
    "src/types/fft-js.d.ts"
  ]
}
