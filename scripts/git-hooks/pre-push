#!/bin/sh
# 公開前の個人情報の検査（CLAUDE.md「公開する前に個人情報が無いことを確かめる」）。
# git が push の直前に呼ぶ。入れ方は `npm run install-git-hooks`（scripts/install-git-hooks.ts）。
#
# 見つかったら（終了コード 1）・調べられなかったら（2）push を止める。
# 検査の道具はメインの checkout のものを使う（ワークツリーには node_modules が無いことがあるため）。
common="$(git rev-parse --path-format=absolute --git-common-dir)" || common=""
if [ -z "$common" ]; then
  echo "[個人情報の検査] git rev-parse --git-common-dir が失敗した。push を止める" >&2
  exit 2
fi
root="$(cd "$common/.." && pwd)"
tsx="$root/node_modules/.bin/tsx"
if [ ! -f "$tsx" ]; then
  echo "[個人情報の検査] $tsx が無い（メインの checkout で npm ci を）。push を止める" >&2
  exit 2
fi
exec "$tsx" "$root/scripts/check-personal-info.ts" --pre-push "$1"
